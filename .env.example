# APP_URL: URL publik tempat aplikasi di-hosting.
APP_URL="https://domain-cbt-anda.com"

# PORT & HOST (untuk VPS / Docker / Railway / Render / cPanel)
PORT="3000"
HOST="0.0.0.0"

# SESSION_SECRET: Kunci acak minimal 32 karakter untuk menandatangani token sesi & CSRF.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# DATABASE_URL: Opsional PostgreSQL connection string (Neon / Supabase / Render / VPS Postgres)
# Wajib diisi jika deploy ke Vercel Serverless agar data tersimpan permanen.
DATABASE_URL=""

# KV_REST_API_URL & KV_REST_API_TOKEN: Alternatif Upstash Redis REST di Vercel Storage.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Alternatif Firebase Service Account JSON (raw atau base64).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# CBT_DATA_DIR: Opsional path penyimpanan file lokal (.data) untuk VPS/Render Persistent Disk.
CBT_DATA_DIR=""
